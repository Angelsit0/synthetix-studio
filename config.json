{
  "app": {
    "name": "Synthetix Studio",
    "version": "0.1.0"
  },
  "paths": {
    "backups": "./backups",
    "logs": "./logs"
  },
  "api": {
    "provider": "openai-compatible",
    "base_url": "https://api.groq.com/openai/v1",
    "endpoint": "/chat/completions",
    "model": "llama-3.3-70b-versatile",
    "api_key_env": "SYNTHETIX_API_KEY",
    "timeout_seconds": 30,
    "max_tokens": 1024
  },
  "editor": {
    "max_line_length": 100,
    "max_function_lines": 40
  }
}
