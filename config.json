{
  "app": {
    "name": "Synthetix Studio",
    "version": "0.1.0"
  },
  "paths": {
    "backups": "./backups",
    "logs": "./logs"
  },
  "api": {
    "provider": "ollama-local",
    "base_url": "http://localhost:11434/v1",
    "endpoint": "/chat/completions",
    "model": "qwen2.5-coder:1.5b",
    "api_key_env": "SYNTHETIX_API_KEY",
    "timeout_seconds": 120,
    "max_tokens": 512
  },
  "editor": {
    "max_line_length": 100,
    "max_function_lines": 40
  }
}
